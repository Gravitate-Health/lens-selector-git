# ===================================================
# Lens Selector Service Configuration
# ===================================================

# ===================================================
# REPOSITORY CONFIGURATION
# Choose ONE of the following configuration modes:
# ===================================================

# ---------------------------------------------------
# Option 1: Multi-Repository Mode (Recommended)
# ---------------------------------------------------
# Specify multiple repositories using REPOS_CONFIG
# Supports three formats:

# A) Inline JSON array:
# REPOS_CONFIG=[{"repoUrl":"https://github.com/org/repo1.git","branch":"main"},{"repoUrl":"https://github.com/org/repo2.git"}]

# B) Local file path:
# REPOS_CONFIG=/path/to/repos-config.json

# C) Remote URL:
# REPOS_CONFIG=https://example.com/repos-config.json

# ---------------------------------------------------
# Option 2: Single Repository Mode (Legacy)
# ---------------------------------------------------
# Use these variables for single repository setup:
GIT_REPO_URL=https://github.com/Gravitate-Health/pregnancy-lens.git
GIT_BRANCH=main
LENS_FILE_PATH=pregnancy-lens.json

# ---------------------------------------------------
# Option 3: Combined Mode
# ---------------------------------------------------
# You can use both REPOS_CONFIG and legacy variables
# They will be merged (duplicates automatically removed)

# ===================================================
# SERVICE CONFIGURATION
# ===================================================

# HTTP server port
PORT=3000

# Cache time-to-live in minutes (default: 5)
CACHE_TTL_MINUTES=5

# Temporary directory for cloned repositories (optional)
# LENS_REPOS_TEMP_DIR=/tmp/lens-repos
